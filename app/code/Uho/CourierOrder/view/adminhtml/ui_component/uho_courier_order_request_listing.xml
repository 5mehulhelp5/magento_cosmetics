<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_components.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">uho_courier_order_request_listing.uho_courier_order_request_listing_data_source</item>
        </item>
        <item name="spinner" xsi:type="string">uho_courier_order_request_columns</item>
        <item name="deps" xsi:type="string">uho_courier_order_request_listing.uho_courier_order_request_listing_data_source</item>
    </argument>
    <settings>
        <spinner>uho_courier_order_request_columns</spinner>
        <deps>
            <dep>uho_courier_order_request_listing.uho_courier_order_request_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="uho_courier_order_request_listing_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">Uho\CourierOrder\Ui\Component\Listing\DataProvider</argument>
            <argument name="name" xsi:type="string">uho_courier_order_request_listing_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">request_id</argument>
            <argument name="requestFieldName" xsi:type="string">id</argument>
        </argument>
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">Magento_Ui/js/grid/provider</item>
            </item>
        </argument>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filterSearch name="fulltext"/>
        <filters name="listing_filters"/>
        <massaction name="listing_massaction">
            <action name="requeue">
                <settings>
                    <type>requeue</type>
                    <label translate="true">Requeue</label>
                    <url path="uho_courierorderrequest/courierorderrequest/massRequeue"/>
                    <confirm>
                        <title translate="true">Requeue</title>
                        <message translate="true">Are you sure you want to requeue the selected request(s)?</message>
                    </confirm>
                </settings>
            </action>
        </massaction>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="uho_courier_order_request_columns">
        <selectionsColumn name="ids">
            <settings>
                <indexField>request_id</indexField>
            </settings>
        </selectionsColumn>
        <column name="request_id">
            <settings>
                <filter>textRange</filter>
                <sorting>desc</sorting>
                <label translate="true">ID</label>
            </settings>
        </column>
        <column name="tracking_number">
            <settings>
                <filter>text</filter>
                <label translate="true">Tracking Number</label>
            </settings>
        </column>
        <column name="full_name">
            <settings>
                <filter>text</filter>
                <label translate="true">Customer</label>
            </settings>
        </column>
        <column name="phone">
            <settings>
                <filter>text</filter>
                <label translate="true">Phone</label>
            </settings>
        </column>
        <column name="total">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Total</label>
            </settings>
        </column>
        <column name="status" component="Magento_Ui/js/grid/columns/select">
            <settings>
                <options class="Uho\CourierOrder\Model\Source\RequestStatusOptions"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Status</label>
            </settings>
        </column>
        <column name="attempts">
            <settings>
                <filter>textRange</filter>
                <label translate="true">Attempts</label>
            </settings>
        </column>
        <column name="order_increment_id">
            <settings>
                <filter>text</filter>
                <label translate="true">Order #</label>
            </settings>
        </column>
        <column name="failure_reason">
            <settings>
                <filter>text</filter>
                <label translate="true">Failure Reason</label>
            </settings>
        </column>
        <column name="created_at" component="Magento_Ui/js/grid/columns/date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Created</label>
            </settings>
        </column>
        <column name="updated_at" component="Magento_Ui/js/grid/columns/date">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Updated</label>
            </settings>
        </column>
    </columns>
</listing>
